APP_NAME=EKA RAG Service
APP_VERSION=1.0.0
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/eka
RAG_PORT=8003
QUERY_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
QUERY_EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.0
MAX_CONTEXT_CHARACTERS=12000
VECTOR_BACKEND=memory
LLM_PROVIDER=local
LLM_MODEL=local-deterministic
